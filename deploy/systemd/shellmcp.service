[Unit]
Description=GPTAdmin Shell MCP agent
After=network.target

[Service]
WorkingDirectory=/home/roomhacker/gptadmin
ExecStart=/home/roomhacker/gptadmin/.venv/bin/python /home/roomhacker/gptadmin/client/rootd.py
Environment=SHELL_TOKEN=srv_secret
Environment=ROOTD_TOKEN=srv_secret
Environment=SHELL_URL=http://192.168.2.100:25900
Environment=ROOTD_URL=http://192.168.2.100:25900
Environment=SHELL_NAME=roomhacker-server-100
Environment=ROOTD_NAME=roomhacker-server-100
Environment=SHELL_IDENTITY_DIR=/etc/gptadmin
Environment=ROOTD_IDENTITY_DIR=/etc/gptadmin
Environment=HUB_URL=https://gptadmin.bezrabotnyi.com/heartbeat
Environment=EXEC_TIMEOUT=300
Environment=LOG_LIMIT_B=8192
Environment=SHELL_TRANSPORT=webhook
Environment=ROOTD_TRANSPORT=webhook
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
