{
  "proxy": [
    {
      "id": "go-shellmcp-network-policy",
      "command": "cd go-shellmcp && go test ./internal/networkproxy -run 'TestPolicy|TestPullAndWebhook' -count=1",
      "evidence": "allowlisted LAN/internet proxy targets and signed offer verification"
    },
    {
      "id": "go-proxyrelay-blackbox",
      "command": "cd go-proxyrelay && go test ./blackbox ./internal/relay ./internal/ticket -count=1",
      "evidence": "real relay stream and ticket contract"
    }
  ],
  "endpoints": [
    {
      "id": "hub-http-contract",
      "command": "python3 -m pytest tests/test_hub_contract.py -q",
      "evidence": "health/version/auth/OpenAPI/MCP endpoint behavior"
    },
    {
      "id": "shellmcp-http-contract",
      "command": "python3 -m pytest tests/test_shellmcp_contract.py -q",
      "evidence": "ShellMCP authenticated endpoint and service contract"
    },
    {
      "id": "canonical-connection-page",
      "command": "cd go-hub && go test ./internal/hub -run 'TestConnectionPageExposesCanonicalClientChoicesWithoutSecrets' -count=1",
      "evidence": "one Hub URL, MCP/OAuth discovery links and Codex/Claude/ChatGPT choices without bearer or password material"
    },
    {
      "id": "typed-admin-security-controls",
      "command": "python3 -m pytest tests/test_admin_ui.py tests/test_shellmcp_heartbeat_config.py -q",
      "evidence": "admin UI uses typed Hub security endpoints and contains no shell env mutation or internal credential controls"
    }
  ],
  "hooks": [
    {
      "id": "webhook-gateway",
      "command": "cd go-hub && go test ./internal/hub -run 'TestWebhookGateway' -count=1",
      "evidence": "token/HMAC ingress, replay window, dispatch and callback"
    },
    {
      "id": "webhook-http-surface",
      "command": "cd go-hub && go test ./internal/hub -run 'TestWebhook(RoutesCRUD|JobsSurviveRestart|JobEndpointRequiresRouteAuth|CallbackRetries)' -count=1",
      "evidence": "authenticated job endpoint and durable delivery state"
    }
  ],
  "mcp_forwarding": [
    {
      "id": "hub-mcp-forwarding",
      "command": "python3 -m pytest tests/test_hub_contract.py -k 'global_mcp or per_server_mcp_and_action_proxy' -q",
      "evidence": "global/per-server list and call result propagation"
    },
    {
      "id": "queued-mcp-forwarding",
      "command": "cd go-shellmcp && go test ./internal/server -run 'TestQueueExecutesGenericMCPToolAndPostsResult' -count=1",
      "evidence": "queue-to-MCP tool execution and result postback"
    }
  ],
  "operations": [
    {
      "id": "doctor-readiness-json",
      "command": "python3 -m pytest tests/test_doctor_json.py -q",
      "evidence": "local unit/config, Hub health, remote clock and permission readiness without secrets"
    },
    {
      "id": "activation-telemetry",
      "command": "cd go-hub && go test ./internal/hub -run 'TestActivationTelemetry(RecordsConnectionAndFirstToolWithoutPayload|IsOptInAggregatedAndPersistent)' -count=1",
      "evidence": "opt-in local event counters, payload exclusion and restart persistence"
    },
    {
      "id": "backup-restore-drill",
      "command": "python3 -m pytest tests/test_backup_restore.py -q",
      "evidence": "manifest/digest round trip, restrictive modes and traversal-safe atomic restore"
    },
    {
      "id": "safe-demo-readonly",
      "command": "cd go-hub && go test ./internal/hub -run 'TestSafeDemoToolIsAvailableToReadonlyMCPWithoutEchoingArguments' -count=1",
      "evidence": "readonly MCP connection check returns build/connection facts without shell, credentials or argument echo"
    },
    {
      "id": "slo-alert-runbook",
      "command": "python3 -m pytest tests/test_slo_docs.py -q",
      "evidence": "operator SLO, error-budget and alert recovery contract is present and tied to machine-readable probes"
    },
    {
      "id": "request-trace-correlation",
      "command": "cd go-hub && go test ./internal/hub -run 'TestRequestTraceID' -count=1",
      "evidence": "bounded X-Request-ID correlation joins MCP policy, queued job and result audit without payloads"
    },
    {
      "id": "shellmcp-trace-propagation",
      "command": "cd go-shellmcp && go test ./internal/server -run 'TestQueueExecutesGenericMCPToolAndPostsResult' -count=1",
      "evidence": "Hub queue trace_id crosses ShellMCP polling, TaskResult and ShellMCP audit without command payloads"
    }
  ],
  "file_sharing": [
    {
      "id": "readonly-inspection",
      "command": "cd go-shellmcp && go test ./internal/inspect -run 'TestReadFile|TestListDirectory' -count=1",
      "evidence": "bounded reads, redaction and metadata-only listing"
    },
    {
      "id": "safe-file-state",
      "command": "cd go-shellmcp && go test ./internal/shell -run 'TestSnapshot|TestRestore' -count=1",
      "evidence": "bounded snapshot and safe restore behavior"
    },
    {
      "id": "managed-file-backup",
      "command": "cd go-shellmcp && go test ./internal/server -run 'TestMCPFileBackupBackupListRestoreCleanup' -count=1",
      "evidence": "MCP file_backup create/list/restore/cleanup contract"
    }
  ],
  "profiles": [
    {
      "id": "admin-access-profile",
      "command": "cd go-hub && go test ./internal/hub -run 'TestManagedClientAccessProfile|TestAccessProfileCASInventoryAndAuthContext|TestAccessProfileSharedConfigRefreshAndWorkspacePersistence|TestAccessProfileRejectsUnsupportedInstructionSet' -count=1",
      "evidence": "profile persistence, live refresh, bindings and effective tool filtering"
    }
  ],
  "security_policies": [
    {
      "id": "capability-policy",
      "command": "cd go-hub && go test ./internal/hub -run 'Test.*Policy|Test.*AuthContext|Test.*Nonce' -count=1",
      "evidence": "fail-closed capability decisions and replay-safe auth"
    },
    {
      "id": "jwt-connection-hygiene",
      "command": "cd go-hub && go test ./internal/hub -run 'TestJWTRequest(RejectsWrongAudienceAndExpiredConnection|RequiresCompleteRecognizedScopedClaims)' -count=1",
      "evidence": "wrong audience/resource, expiry, missing/unknown scope, subject, issued-at, key-id and admin-token-forwarding rejection"
    },
    {
      "id": "operator-audit-decision",
      "command": "cd go-hub && go test ./internal/hub -run 'Test(ToolAuditIncludesActorPolicyDigestAndResultReference|DeniedToolAuditIncludesPolicyReasonWithoutArguments|AuditIncidentDrillRecoversDecisionWithoutRawArguments|AuditTrailSurvivesHubRestartWithRestrictivePermissions|AuditEndpointFiltersSearchesAndPaginatesWithoutRawArguments)' -count=1",
      "evidence": "actor, target, allow/deny policy decisions, durable/searchable audit, pagination, argument digest and result reference without raw arguments"
    },
    {
      "id": "ask-before-write",
      "command": "cd go-hub && go test ./internal/hub -run 'Test(AskBeforeWrite(RequiresAdminApprovalAndConsumesApproval|CoversPinnedServerAndLegacyAgentAliases)|BoundedAutonomousProfileStopsWriteBudgetAcrossRelay)' -count=1",
      "evidence": "write-capable MCP calls and aliases enforce approval, one-time consume, and bounded-autonomous per-actor budgets"
    },
    {
      "id": "readonly-security",
      "command": "cd go-shellmcp && go test ./internal/inspect ./internal/redact ./internal/security -count=1",
      "evidence": "path boundary, symlink/credential rejection and secret redaction"
    },
    {
      "id": "repository-secret-boundary",
      "command": "python3 -m pytest tests/test_no_secrets.py tests/test_public_mirror.py -q",
      "evidence": "tracked-tree public/private and credential scan"
    },
    {
      "id": "security-preset-mfa",
      "command": "cd go-hub && go test ./internal/hub -run 'Test(SecurityPresetAndTOTPFailClosedUntilEnrollment|SensitiveSecurityMutationRequiresFreshAdminReauth)' -count=1",
      "evidence": "preset persistence, locked-down fail-closed behavior, TOTP enrollment/verification, fresh security re-auth and MFA-required admin login"
    },
    {
      "id": "typed-heartbeat-endpoint",
      "command": "cd go-hub && go test ./internal/hub -run 'TestSecurityHeartbeatUsesTypedAdminEndpoint' -count=1",
      "evidence": "heartbeat preference changes use a typed boolean endpoint and never accept an operator shell command"
    }
  ],
  "release_provenance": [
    {
      "id": "release-manifest-tamper-check",
      "command": "python3 -m pytest tests/test_release_provenance.py tests/test_sbom.py tests/test_update_semantics.py -q",
      "evidence": "artifact provenance/SBOM, canonical manifest compatibility and installer digest rejection"
    },
    {
      "id": "release-workflow-gates",
      "command": "python3 -m pytest tests/test_release_workflow_contract.py -q",
      "evidence": "release workflow verifies manifest/SBOM and shipped installer links before publication"
    }
  ],
  "golden_paths": [
    {
      "id": "platform-client-paths",
      "command": "python3 -m pytest tests/test_golden_paths.py -q",
      "evidence": "Linux/macOS/Windows/Android and Codex/Claude/ChatGPT install/auth/tool/rollback contract"
    }
  ]
}
