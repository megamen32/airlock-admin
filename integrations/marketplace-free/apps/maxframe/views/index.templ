package views
import "github.com/a-h/templ"
templ Index(v HomeView) {
 @Layout(v.Title) {
  <p class="text-sm mb-4">MAXFRAME · АНАЛИТИКА MAX</p>
  <h1 class="text-3xl font-semibold mb-4">Узнайте аудиторию канала</h1>
  <p class="mb-6">Вставьте публичную ссылку на MAX-канал: посмотрим описание, подписчиков и доступную статистику просмотров.</p>
  if v.Message != "" {
   <section class="card bg-base-200 mb-6" aria-live="polite">
    <div class="card-body">
     <h2 class="font-semibold">{ v.Message }</h2>
     if v.Ready {
      if len(v.Channels) == 0 { <p>В каталоге пока нет каналов.</p> }
      for _, c := range v.Channels {
       <article class="mt-4 border-t border-base-300 pt-4">
        <h3 class="text-xl font-semibold"><a class="link" href={ templ.SafeURL(c.Link) } target="_blank" rel="noopener noreferrer">{ c.Title } ↗</a></h3>
        <p class="mt-2 whitespace-pre-line break-words">{ c.Description }</p>
        if c.Category != "" { <p class="mt-2">Категория: { c.Category }</p> }
        if c.Followers != "" { <p class="mt-3 font-semibold">Подписчиков: { c.Followers }</p> }
        if c.Views24 != "" { <p>Просмотры за 24 часа: { c.Views24 }</p> }
        if c.Views48 != "" { <p>Просмотры за 48 часов: { c.Views48 }</p> }
        if c.ER24 != "" { <p>ER за 24 часа: { c.ER24 }</p> }
        if c.ER48 != "" { <p>ER за 48 часов: { c.ER48 }</p> }
        if c.UpdatedAt != "" { <p class="text-sm mt-3">Обновлено у источника: { c.UpdatedAt }</p> }
       </article>
      }
      <p class="text-sm mt-6">Источник: MaxFrame API. Получено { v.FetchedAt }. Отсутствующие метрики не отображаются.</p>
     }
    </div>
   </section>
  }
  <form method="post" action="/summary" class="space-y-4">
   <label class="block" for="channel-link">Публичная ссылка на канал</label>
   <input id="channel-link" class="input input-bordered w-full" name="link" value={ v.Link } placeholder="https://max.ru/ria" maxlength="300"/>
   <div class="flex flex-wrap gap-3">
    <button class="btn btn-primary" type="submit" name="mode" value="channel">@ActionIcon("chart-no-axes-combined") Показать статистику</button>
    <button class="btn btn-outline" type="submit" name="mode" value="catalog">@ActionIcon("list") Посмотреть каталог</button>
   </div>
  </form>
  <p class="text-sm mt-6">Каталог показывает первые пять записей, без поиска по теме. Кэш — 10 минут; до 12 обновлений в час на всё демо.</p>
  <p class="text-sm mt-4">Только публичные данные. Подключение не отправляет сообщения, не меняет каналы и не покупает рекламу.</p>
 }
}
