package views
import "strconv"
templ Index(v HomeView) {
 @Layout("Видимость Airlock в ИИ — Semantica AI") {
  <p class="text-sm mb-3">Semantica AI · исследование видимости бренда</p>
  <h1 class="text-3xl font-semibold mb-4">Знают ли нейросети об Airlock?</h1>
  <p class="mb-4">Посмотрите настоящий скан: какие ответы получены на вопрос о self-hosted ИИ-платформах и встречается ли в них Airlock.</p>
  <form method="post" action="/summary">
   <button class="btn btn-primary" type="submit">@ActionIcon("chart-no-axes-combined") Открыть отчёт</button>
  </form>
  if v.Result.Message != "" {
   <section class="card bg-base-200 mt-6"><div class="card-body">
    <h2 class="card-title">Результат скана</h2>
    <p>{ v.Result.Message }</p>
    if v.Result.Ready {
     <p><strong>{ v.Result.Brand }</strong> · { v.Result.Domain }</p>
     <p>Скан завершён: { v.Result.ScannedAt }</p>
     for _,q := range v.Result.Queries {
      <blockquote class="border-l-4 border-primary pl-4 my-4">{ q }</blockquote>
     }
     <div class="overflow-x-auto"><table class="table"><thead><tr><th>Нейросеть</th><th>Ответов</th><th>Упоминаний Airlock</th><th>Не получено</th></tr></thead><tbody>
      for _,p := range v.Result.Providers {
       <tr><th>{ p.Name }</th><td>{ strconv.Itoa(p.Received) } / { strconv.Itoa(p.Requested) }</td><td>
        if p.Received>0 {
         { strconv.Itoa(p.Mentions) }
        } else {
         <span>Нет данных</span>
        }
       </td><td>{ strconv.Itoa(p.Failed) }</td></tr>
      }
     </tbody></table></div>
     <p class="text-sm">Источник: { v.Result.Source }. Прочитано: { v.Result.FetchedAt }</p>
    }
   </div></section>
  }
  <section class="mt-8"><h2 class="font-semibold mb-2">Как читать результат</h2>
   <p>Это один демонстрационный вопрос и фиксированный скан от 15 октября 2026 года. Отсутствие упоминания в нём не означает, что бренд неизвестен всем нейросетям. Ошибки провайдеров показаны отдельно.</p>
   <p class="mt-3 text-sm">Доступ на подарочных кредитах без оплаты. Новые сканы и изменение проекта закрыты. Кэш 30 минут; общий лимит — 4 обновления в час и 20 за всё время.</p>
  </section>
 }
}
